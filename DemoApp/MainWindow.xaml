<Window x:Class="DemoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DemoApp"
        mc:Ignorable="d"
        Title="Чудо Обувь - Каталог обуви" Height="450" Width="800"
        Icon="/Resources/logo.ico"
        FontFamily="Calibri" FontSize="14"
        Background="{StaticResource MainBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="{StaticResource AdditionalBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Image Source="/Resources/logo.png" Height="65" Width="65" Margin="5" Stretch="Uniform"/>
            <TextBlock Grid.Column="1" Text="Чудо Обувь - Каталог товаров" VerticalAlignment="Center" FontSize="22" />
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ProductList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Margin="7" Padding="10" Height="118">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="150"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="{Binding Image}" Width="125" Height="95" Stretch="Uniform"></Image>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                    <TextBlock Text="{Binding Title}" FontSize="18"></TextBlock>
                                    <TextBlock Text="{Binding Category}" FontSize="15"></TextBlock>
                                    <TextBlock Text="{Binding Quantity, StringFormat='Количество на складе: {0}'}" FontSize="15"></TextBlock>
                                    <TextBlock Text="{Binding Compound}" FontSize="14"></TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Price, StringFormat={}{0:N2} руб.}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
