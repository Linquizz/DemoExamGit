<Application x:Class="DemoApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DemoApp"
             StartupUri="LoginWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="MainBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AdditionalBackgroundBrush" Color="#D2F6E7"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#70B2AF"/>
        <SolidColorBrush x:Key="LowStockBrush" Color="#FF8080"/>
    </Application.Resources>
</Application>
